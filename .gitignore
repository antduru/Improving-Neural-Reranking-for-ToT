# Project .gitignore
#
# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs / temp
*.log
*.tmp
*.swp

# Data (keep placeholders/docs if any)
data/**
!data/.gitkeep
!data/README.md

# Generated reports / figures
reports/figures/**
reports/**/*.png
reports/**/*.jpg
reports/**/*.jpeg

# Experiment tracking / outputs
wandb/
mlruns/
lightning_logs/
runs/
outputs/
checkpoints/
tb_logs/
cache/
events.out.tfevents.*

# Model artifacts (usually large)
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors

# Secrets
.env
.env.*
